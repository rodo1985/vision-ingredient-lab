# Copy this file to `.env` and replace the placeholder values as needed.

# Required for real OpenAI-backed metadata extraction, embeddings, and image generation.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. If omitted, the backend defaults to https://api.openai.com/v1.
# Set this only when you intentionally use a custom-compatible endpoint.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model used to analyze source ingredient images.
VISION_MODEL=gpt-4.1-mini

# Model used to generate semantic search embeddings.
EMBEDDING_MODEL=text-embedding-3-small

# Model used to generate creative output images.
IMAGE_GENERATION_MODEL=gpt-image-1.5

# When true, the backend runs a sync automatically on app startup.
# Keep this false for the first local setup so sync is explicit.
ENABLE_STARTUP_SYNC=false
